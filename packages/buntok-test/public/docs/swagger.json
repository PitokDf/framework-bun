      }
    },
    "/tests/upload": {
      "post": {
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "docs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary",
                      "description": "Binary file (accept: image/png, image/jpeg, image/webp)"
                    }
                  }
                },
                "required": [
                  "docs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
