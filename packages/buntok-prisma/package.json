{
	"name": "@buntok/prisma",
	"version": "1.0.8",
	"scripts": {
		"build": "tsup && tsc"
	},
	"description": "Prisma BaseRepository for Buntok framework",
	"module": "dist/index.js",
	"type": "module",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"bun",
		"framework",
		"prisma",
		"orm",
		"repository",
		"crud"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {},
	"peerDependencies": {
		"@prisma/client": ">=6.0.0"
	}
}
