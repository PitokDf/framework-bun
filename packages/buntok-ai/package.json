{
  "name": "@buntok/ai",
  "version": "1.0.0",
  "description": "Provider-agnostic AI SDK for Buntok — streaming, tool calling, chat history, RAG, and middleware",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "chat",
    "streaming",
    "tool-calling",
    "rag",
    "buntok"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@buntok/core": ">=1.0.0",
    "zod": ">=3.0.0",
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.20.0",
    "@google/genai": ">=1.0.0",
    "@mistralai/mistralai": ">=1.0.0",
    "@cohere-ai/sdk": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true },
    "@anthropic-ai/sdk": { "optional": true },
    "@google/genai": { "optional": true },
    "@mistralai/mistralai": { "optional": true },
    "@cohere-ai/sdk": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
